# ─── Repassa Aí — variáveis de ambiente ───
# Copie para .env e preencha. NUNCA versione o .env. Detalhes: docs/VARIAVEIS_AMBIENTE.md

# Ambiente lógico: development | test | staging | production
# Em "production", simulações de pagamento/frete/e-mail/storage são BLOQUEADAS.
APP_ENV="development"

# Banco PostgreSQL (pooling) e conexão direta (migrations)
DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa?schema=public"
DIRECT_DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa?schema=public"

# Autenticação (gere com: openssl rand -base64 48)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cifragem de tokens de terceiros — 32 bytes em base64 (openssl rand -base64 32)
ENCRYPTION_KEY=""

# E-mail: console (dev, só registra no log) | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Repassa Aí <nao-responda@seudominio.com.br>"
RESEND_API_KEY=""

# Storage de imagens: local (dev) | supabase
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Integrações: simulated (dev) | mercadopago / melhorenvio (Etapa 5)
PAYMENT_PROVIDER="simulated"
SHIPPING_PROVIDER="simulated"

# Seed opcional de administrador (apenas para o primeiro deploy; remova depois)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Testes de integração: banco SEPARADO (o nome deve conter "test")
TEST_DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa_test?schema=public"
# Assistente de anúncio por IA (Claude). Vazio = desligado.
AI_PROVIDER=""
AI_MODEL=""
ANTHROPIC_API_KEY=""
