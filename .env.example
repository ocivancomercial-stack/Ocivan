# ─── Repassa Aí — variáveis de ambiente ───
# Copie para .env e preencha. NUNCA versione o .env. Detalhes: docs/VARIAVEIS_AMBIENTE.md

# Ambiente lógico: development | test | staging | production
# Em "production", simulações de pagamento/frete/e-mail/storage são BLOQUEADAS.
APP_ENV="development"

# Banco PostgreSQL (pooling) e conexão direta (migrations)
DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa?schema=public"
DIRECT_DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa?schema=public"

# Autenticação (gere com: openssl rand -base64 48)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cifragem de tokens de terceiros — 32 bytes em base64 (openssl rand -base64 32)
ENCRYPTION_KEY=""

# E-mail: console (dev, só registra no log) | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Repassa Aí <nao-responda@seudominio.com.br>"
RESEND_API_KEY=""

# Storage de imagens: local (dev) | supabase
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Integrações: simulated (dev) | mercadopago / melhorenvio
# Para testar as integrações reais sem conta, veja .env.test-model.example e docs/MODELO_DE_TESTE.md
PAYMENT_PROVIDER="simulated"
SHIPPING_PROVIDER="simulated"
MOCK_PROVIDERS=""

# Mercado Pago (Suas integrações → aplicação → credenciais + Webhooks › assinatura secreta)
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""      # opcional: token da conta da plataforma
MERCADOPAGO_TEST_MODE=""         # "1" = credenciais de teste (sandbox_init_point, test_token)
MERCADOPAGO_API_URL=""           # vazio = https://api.mercadopago.com
MERCADOPAGO_AUTH_URL=""          # vazio = https://auth.mercadopago.com/authorization

# Melhor Envio (Área Dev. → aplicativo; callback: <APP_URL>/api/integrations/melhorenvio/callback)
MELHORENVIO_CLIENT_ID=""
MELHORENVIO_CLIENT_SECRET=""     # também valida o X-ME-Signature dos webhooks
MELHORENVIO_SANDBOX=""           # "1" = https://sandbox.melhorenvio.com.br
MELHORENVIO_USER_AGENT="Repassa Ai (suporte@seudominio.com.br)"
MELHORENVIO_TOKEN=""             # opcional: token gerado no painel em vez do OAuth
MELHORENVIO_API_URL=""

# Protege a rotina de expiração de reservas (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Seed opcional de administrador (apenas para o primeiro deploy; remova depois)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Testes de integração: banco SEPARADO (o nome deve conter "test")
TEST_DATABASE_URL="postgresql://repassa:repassa@localhost:5432/repassa_test?schema=public"
# Assistente de anúncio por IA (Claude). Vazio = desligado.
AI_PROVIDER=""
AI_MODEL=""
ANTHROPIC_API_KEY=""
