# Copie para .env e ajuste.
PORT=3000

# Pasta do app. O servidor serve o app em http://localhost:PORT/, na mesma origem da API.
# Deixe vazio para usar ../frontend.
FRONTEND_DIR=

# Origens autorizadas a chamar a API, só se o app for hospedado em OUTRO endereço. Separe várias por vírgula.
CORS_ORIGIN=http://localhost:5173

# Banco. Com DATABASE_URL, usa PostgreSQL (obrigatório em produção). Sem ela, usa SQLite no arquivo DB_PATH.
# Ex.: postgres://usuario:senha@host:5432/vidaplena?sslmode=require
DATABASE_URL=
# Schema do PostgreSQL (opcional; padrão: public)
DB_SCHEMA=
DB_PATH=./data/vida-plena.db

# Chave da criptografia da declaração de saúde (LGPD): 32 bytes em base64. Obrigatória com PostgreSQL ou NODE_ENV=production.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia em local seguro: sem ela, as declarações gravadas não podem ser lidas.
CHAVE_DADOS_SENSIVEIS=

# Token para as rotas /api/admin/* (relatórios de comissão). Use um valor longo e aleatório.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Comissão de corretagem padrão, em %, aplicada a TODAS as propostas.
COMISSAO_PERCENTUAL=30

# Vigência da apólice e renovação
VIGENCIA_ANOS=5
RENOVACAO_AUTOMATICA=true
# Quantos dias antes do fim da vigência a renovação é processada
RENOVACAO_ANTECEDENCIA_DIAS=30
# Agendador interno: roda a renovação uma vez por dia a partir desta hora (0 a 23), no fuso abaixo.
# Com vários servidores no ar, só um executa cada dia. Use AGENDADOR_ATIVO=false para desligar.
AGENDADOR_ATIVO=true
RENOVACAO_HORA=3
FUSO_HORARIO=America/Sao_Paulo

# Seguradora: "mock" (simulação) ou "tokio" (API real, quando houver credenciais)
INSURER=mock
TOKIO_BASE_URL=
TOKIO_CLIENT_ID=
TOKIO_CLIENT_SECRET=
CORRETOR_SUSEP=

# Cobrança no cartão: "mock" (simulação) ou "tokio" (plataforma da Tokio Marine).
# PAYMENTS=tokio exige INSURER=tokio: a cobrança usa as mesmas credenciais da Tokio.
PAYMENTS=mock
WEBHOOK_SECRET=troque-por-outro-token
