# Copie para .env e ajuste.
PORT=3000

# Pasta do app. O servidor serve o app em http://localhost:PORT/, na mesma origem da API.
# Deixe vazio para usar ../frontend.
FRONTEND_DIR=

# Origens autorizadas a chamar a API, só se o app for hospedado em OUTRO endereço. Separe várias por vírgula.
CORS_ORIGIN=http://localhost:5173

# Banco SQLite (arquivo). Em produção, troque por PostgreSQL.
DB_PATH=./data/vida-plena.db

# Token para as rotas /api/admin/* (relatórios de comissão). Use um valor longo e aleatório.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Comissão de corretagem padrão, em %, aplicada a TODAS as propostas.
COMISSAO_PERCENTUAL=30

# Vigência da apólice e renovação
VIGENCIA_ANOS=5
RENOVACAO_AUTOMATICA=true
# Quantos dias antes do fim da vigência a renovação é processada
RENOVACAO_ANTECEDENCIA_DIAS=30

# Seguradora: "mock" (simulação) ou "tokio" (API real, quando houver credenciais)
INSURER=mock
TOKIO_BASE_URL=
TOKIO_CLIENT_ID=
TOKIO_CLIENT_SECRET=
CORRETOR_SUSEP=

# Pagamento: "mock" (simulação) ou "gateway" (Pagar.me, Stripe, Mercado Pago...)
PAYMENTS=mock
GATEWAY_API_KEY=
WEBHOOK_SECRET=troque-por-outro-token
