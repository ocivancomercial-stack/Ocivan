# ─── Modelo de teste: integrações REAIS (Mercado Pago + Melhor Envio) contra os SIMULADORES ───
# Copie estas linhas para o seu .env (desenvolvimento/homologação). Proibido com APP_ENV=production.
# Passo a passo em docs/MODELO_DE_TESTE.md
MOCK_PROVIDERS=1

PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_API_URL=http://localhost:3000/api/mock/mercadopago
MERCADOPAGO_AUTH_URL=http://localhost:3000/api/mock/mercadopago/authorization
MERCADOPAGO_CLIENT_ID=1234567890
MERCADOPAGO_CLIENT_SECRET=dev-mp-client-secret
MERCADOPAGO_WEBHOOK_SECRET=dev-mp-webhook-secret
MERCADOPAGO_TEST_MODE=1

SHIPPING_PROVIDER=melhorenvio
MELHORENVIO_API_URL=http://localhost:3000/api/mock/melhorenvio
MELHORENVIO_CLIENT_ID=4321
MELHORENVIO_CLIENT_SECRET=dev-me-client-secret
MELHORENVIO_USER_AGENT="Repassa Ai Dev (dev@repassaai.dev)"
